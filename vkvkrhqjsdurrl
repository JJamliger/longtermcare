import os
import time
import threading
import logging
import urllib.parse
import sys
import atexit
import signal
import subprocess
from flask import Flask, request
from selenium import webdriver
from selenium.webdriver.chrome.service import Service
from selenium.webdriver.chrome.options import Options
from selenium.webdriver.common.by import By
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC
from webdriver_manager.chrome import ChromeDriverManager
from queue import LifoQueue

# --- [1] 설정 및 색상 코드 ---
NUM_DRIVERS = 4
PORT = 55555 
# ANSI 색상 코드 (윈도우 터미널 대응)
RESET = "\033[0m"
GREEN = "\033[92m"
YELLOW = "\033[93m"
CYAN = "\033[96m"
RED = "\033[91m"
MAGENTA = "\033[95m"
BLUE = "\033[94m"

app = Flask(__name__)
drivers_pool = LifoQueue()
translation_cache = {}
processing_now = set()
lock = threading.Lock()

stats = {
    "total_translated": 0,
    "last_active": time.time(),
    "status": "Initializing..."
}

# --- [2] 시스템 관리 함수 ---

def set_terminal_title(msg):
    """윈도우 터미널 제목 표시줄 업데이트"""
    try: os.system(f'title "{msg}"')
    except: pass

def kill_port_process(port):
    """포트 점유 중인 프로세스 정리 (중복 실행 방지)"""
    try:
        cmd = f"netstat -ano | findstr :{port}"
        result = subprocess.check_output(cmd, shell=True).decode()
        if result:
            for line in result.strip().split('\n'):
                parts = line.split()
                if len(parts) > 4:
                    pid = parts[-1]
                    if pid != "0" and pid != "4": # 시스템 프로세스 제외
                        print(f"{RED}[SYSTEM] 기존 포트 점유 프로세스(PID: {pid}) 종료...{RESET}")
                        os.system(f"taskkill /F /PID {pid}")
            time.sleep(1)
    except: pass

def cleanup_drivers():
    """종료 시 모든 브라우저 닫기"""
    print(f"\n{YELLOW}[SYSTEM] 종료 감지: 모든 크롬 프로세스를 정리하는 중...{RESET}")
    while not drivers_pool.empty():
        try:
            driver = drivers_pool.get_nowait()
            driver.quit()
        except: pass
    print(f"{GREEN}[SYSTEM] 정리 완료. 안전하게 종료되었습니다.{RESET}")

atexit.register(cleanup_drivers)
signal.signal(signal.SIGTERM, lambda sig, frame: sys.exit(0))
signal.signal(signal.SIGINT, lambda sig, frame: sys.exit(0))

# --- [3] 브라우저 엔진 함수 ---

def create_driver():
    """메모리 최적화 브라우저 생성"""
    options = Options()
    options.add_argument("--headless")
    options.add_argument("--no-sandbox")
    options.add_argument("--disable-dev-shm-usage")
    options.add_argument("--disable-gpu")
    options.add_argument("--log-level=3")
    options.add_experimental_option('excludeSwitches', ['enable-logging'])
    
    # 리소스 차단 (이미지/CSS/폰트)
    prefs = {"profile.managed_default_content_settings.images": 2, 
             "profile.managed_default_content_settings.stylesheets": 2,
             "profile.managed_default_content_settings.fonts": 2}
    options.add_experimental_option("prefs", prefs)
    
    return webdriver.Chrome(service=Service(ChromeDriverManager().install()), options=options)

def self_health_checker():
    """실시간 상태 감시 스레드"""
    while True:
        current_time = time.time()
        idle_time = int(current_time - stats["last_active"])
        available_drivers = drivers_pool.qsize()
        
        status_msg = f"Status: {stats['status']} | Idle: {idle_time}s | Ready: {available_drivers}/{NUM_DRIVERS} | Total: {stats['total_translated']}"
        set_terminal_title(status_msg)
        
        if len(processing_now) > 0 and idle_time > 60:
            stats["status"] = f"{RED}STUCK WARNING!{RESET}"
        
        time.sleep(1)

def translate_crawling(text):
    """파파고 크롤링 로직"""
    driver = drivers_pool.get()
    try:
        stats["status"] = "Translating..."
        safe_text = urllib.parse.quote(text)
        driver.get(f"https://papago.naver.com/?sk=zh-CN&tk=ko&hn=0&st={safe_text}")
        
        wait = WebDriverWait(driver, 10)
        result_element = wait.until(EC.presence_of_element_located((By.ID, "txtTarget")))
        
        time.sleep(0.8) # 텍스트 안착 대기
        res = result_element.text
        
        if res and res != "..." and res != text:
            stats["total_translated"] += 1
            return res
        return None
    except:
        try: driver.quit()
        except: pass
        return "RETRY"
    finally:
        stats["status"] = "Idle"
        drivers_pool.put(driver)

# --- [4] 메인 서버 로직 ---

@app.route('/translate', methods=['GET', 'POST'])
def translate():
    stats["last_active"] = time.time()
    
    content = request.args.get('text') or (request.get_json().get('text') if request.is_json else request.form.get('text'))
    if not content: return ""

    # 1. 캐시 확인 (하늘색 출력)
    if content in translation_cache:
        res = translation_cache[content]
        print(f"{CYAN}[CACHE]{RESET} {content[:40]}... -> {res[:40]}...")
        return res

    # 2. 중복 방지
    with lock:
        if content in processing_now or len(processing_now) >= NUM_DRIVERS:
            return content
        processing_now.add(content)

    try:
        # 3. 번역 (초록색 출력)
        translated = translate_crawling(content)
        
        if translated == "RETRY":
            drivers_pool.put(create_driver())
            return content

        if translated:
            translation_cache[content] = translated
            print(f"{GREEN}[DONE]{RESET} {content[:60]}\n      {GREEN}=>{RESET} {translated[:60]}")
            return translated
        
        return content
    finally:
        with lock:
            if content in processing_now:
                processing_now.remove(content)

if __name__ == '__main__':
    # Flask 로고 및 로그 숨기기
    log = logging.getLogger('werkzeug')
    log.setLevel(logging.ERROR)
    
    print(f"{BLUE}=================================================={RESET}")
    print(f"{BLUE}   Auto Translator System - Deployment Version    {RESET}")
    print(f"{BLUE}=================================================={RESET}")
    
    kill_port_process(PORT)
    
    try:
        print(f"{YELLOW}[SYSTEM] 엔진 {NUM_DRIVERS}개 초기화 시작...{RESET}")
        for i in range(NUM_DRIVERS):
            drivers_pool.put(create_driver())
            print(f"{YELLOW}[SYSTEM]{RESET} 엔진 #{i+1} 가동 완료.")
        
        threading.Thread(target=self_health_checker, daemon=True).start()
        
        print(f"\n{GREEN}[SUCCESS] 서버 활성화 완료!{RESET}")
        print(f"{MAGENTA}[CONFIG] Endpoint = http://127.0.0.1:{PORT}/translate{RESET}")
        print(f"{CYAN}[TIPS] 창 제목의 Idle 숫자를 보고 생존 여부를 확인하세요.{RESET}\n")
        
        app.run(host='127.0.0.1', port=PORT, threaded=True, use_reloader=False)

    except Exception as e:
        print(f"\n{RED}[FATAL ERROR] {e}{RESET}")
        input("엔터를 눌러 종료하세요...")
